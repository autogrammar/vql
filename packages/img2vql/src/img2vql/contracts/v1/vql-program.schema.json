{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vql.dev/contracts/img2vql/v1/vql-program.schema.json",
  "title": "VQLProgram LLM Contract v1",
  "type": "object",
  "required": ["version", "render_target", "scene", "metadata"],
  "properties": {
    "version": { "const": "1.0" },
    "render_target": { "enum": ["svg", "playwright", "canvas"] },
    "scene": { "$ref": "#/$defs/scene" },
    "validation": {
      "anyOf": [{ "$ref": "#/$defs/validation" }, { "type": "null" }]
    },
    "metadata": { "$ref": "#/$defs/freeObject" }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "required": ["width", "height", "layers"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "background": { "type": "string", "minLength": 1, "maxLength": 200 },
        "url": { "type": "string", "maxLength": 4000 },
        "app": { "type": "string", "maxLength": 500 },
        "layers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/layer" }
        },
        "relations": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/relation" }
        }
      },
      "additionalProperties": false
    },
    "layer": {
      "type": "object",
      "required": ["id", "objects"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 500 },
        "objects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/object" }
        },
        "visible": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "required": ["id", "primitives", "center_x", "center_y"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 500 },
        "primitives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/primitive" }
        },
        "style": { "$ref": "#/$defs/style" },
        "transform": { "$ref": "#/$defs/transform" },
        "center_x": { "type": "number" },
        "center_y": { "type": "number" },
        "anchors": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/anchor" }
        },
        "constraints": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/constraint" }
        },
        "metadata": { "$ref": "#/$defs/freeObject" }
      },
      "additionalProperties": false
    },
    "primitive": {
      "type": "object",
      "required": ["shape_type", "params"],
      "properties": {
        "shape_type": { "type": "string", "minLength": 1, "maxLength": 200 },
        "params": { "$ref": "#/$defs/freeObject" }
      },
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "color": { "type": "string", "minLength": 1, "maxLength": 200 },
        "fill": { "type": "boolean" },
        "stroke_width": { "type": "number", "minimum": 0 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "transform": {
      "type": "object",
      "properties": {
        "translate_x": { "type": "number" },
        "translate_y": { "type": "number" },
        "scale_x": { "type": "number" },
        "scale_y": { "type": "number" },
        "rotate_deg": { "type": "number" }
      },
      "additionalProperties": false
    },
    "anchor": {
      "type": "object",
      "required": ["name", "x", "y"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "required": ["kind", "args"],
      "properties": {
        "kind": { "type": "string", "minLength": 1, "maxLength": 200 },
        "args": { "$ref": "#/$defs/freeObject" }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": ["kind", "source", "target", "args"],
      "properties": {
        "kind": { "type": "string", "minLength": 1, "maxLength": 200 },
        "source": { "type": "string", "minLength": 1, "maxLength": 500 },
        "target": { "type": "string", "minLength": 1, "maxLength": 500 },
        "args": { "$ref": "#/$defs/freeObject" }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "properties": {
        "description": { "type": "string", "maxLength": 4000 },
        "expected_shapes": { "type": "array", "items": { "type": "string" } },
        "expected_colors": { "type": "array", "items": { "type": "string" } },
        "min_objects": { "type": "integer", "minimum": 0 },
        "custom": { "$ref": "#/$defs/freeObject" }
      },
      "additionalProperties": false
    },
    "freeObject": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
